# API Keys (Never commit your actual .env file)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# LLM Providers (Groq Primary -> Gemini Fallback)
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=llama-3.3-70b-versatile
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=1

# Network & Logging
HTTP_TIMEOUT_SECONDS=25.0
MAX_RETRIES_PER_MODEL=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10

# Optional: Override model lists on the fly without changing code
GROQ_MODELS=
GROQ_VISION_MODELS=
GEMINI_MODELS=

# Vector Database (Pinecone)
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=code-storm
PINECONE_NAMESPACE=default
PINECONE_HOST=
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL_NAME=multilingual-e5-large

# Database (Aiven PostgreSQL or local SQLite)
DATABASE_URL=postgresql+psycopg://png5:replace_local_password@localhost:5432/png5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_SSL_MODE=require

# Governance demo identities: generate distinct tokens; never commit real values.
GOVERNOR_ANALYST_TOKEN=
GOVERNOR_SUPPORT_TOKEN=
GOVERNOR_REVIEWER_TOKEN=
GOVERNOR_REVIEWER_PERMISSIONS=review,audit,knowledge_admin

# PostgreSQL company workspace API: workspace.api:app
WORKSPACE_SIGNING_SECRET=
WORKSPACE_DEMO_MODE=false
# Exact administrator-controlled HTTPS policy source hosts; empty disables URL ingestion.
POLICY_URL_HOSTS=
POLICY_COMPILATION_LLM=false
WORKSPACE_POLICY_EMBEDDINGS=false
# Optional explicitly configured imported reviewer mapping (never sent to browser):
DEMO_ORGANIZATION_ID=
DEMO_REVIEWER_USER_ID=

