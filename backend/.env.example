# ==============================================================================
# CODE_STORM — Production Environment Configuration
# Duplicate this file as .env in the backend directory.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

APP_NAME=CODE_STORM
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 1. Aiven PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<AIVEN_HOST>:<PORT>/<DATABASE>?ssl=require
# Aiven PostgreSQL requires SSL encryption by default.
DATABASE_URL=postgresql+asyncpg://avnadmin:your_aiven_password_here@pg-your-project.aivencloud.com:21345/defaultdb?ssl=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_SSL_MODE=require

# ------------------------------------------------------------------------------
# 2. Pinecone Vector Database Configuration
# ------------------------------------------------------------------------------
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=code-storm
PINECONE_NAMESPACE=default
PINECONE_HOST=
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL_NAME=multilingual-e5-large

# ------------------------------------------------------------------------------
# 3. LLM Providers & Failover Cascade (Groq Primary -> Gemini Fallback)
# ------------------------------------------------------------------------------
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=llama-3.3-70b-versatile

FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_MODEL=gemini-2.5-flash

# API Credentials
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Timeout and Resilience Settings
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=1
HTTP_TIMEOUT_SECONDS=25.0
MAX_RETRIES_PER_MODEL=2

# Optional model cascades (comma-separated lists)
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_VISION_MODELS=llama-3.2-11b-vision-preview,llama-3.2-90b-vision-preview
GEMINI_MODELS=gemini-2.5-flash,gemini-1.5-flash,gemini-1.5-pro

# ------------------------------------------------------------------------------
# 4. Security & CORS Configuration
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10
